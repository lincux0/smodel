---
import type { CollectionEntry } from 'astro:content';
import { taskLabels } from '../lib/catalog.ts';
import { parameterBand } from '../lib/catalog-query.ts';
interface Props { models: CollectionEntry<'models'>[]; interactive?: boolean; }
const { models, interactive = false } = Astro.props;
---
<div class="model-list-shell" data-model-catalog={interactive ? 'true' : undefined}>
  {interactive && <p data-results-count role="status" aria-live="polite"></p>}
  {interactive && <p data-selection-error role="status" aria-live="polite" hidden></p>}
  <ul class="model-list">
    {models.map(({ data: model }, index) => (
      <li data-model-card data-id={model.id} data-tasks={model.tasks.join(' ')} data-task-labels={model.tasks.map((task) => taskLabels[task]).join(' / ')} data-name={model.name} data-family={model.family} data-search={`${model.name} ${model.family} ${model.summary} ${model.tasks.map((task) => taskLabels[task]).join(' ')}`} data-parameters={model.parameters.totalB === null ? '' : model.parameters.totalB} data-parameter-label={model.parameters.totalB === null ? '规模未提供' : `${model.parameters.totalB}B`} data-size={parameterBand(model.parameters.totalB)} data-license={model.licenses.weights.name} data-runtimes={JSON.stringify([...new Set(model.deployments.map(({ runtime }) => runtime))])} data-parameter-notes={model.parameters.notes} data-checked={model.checkedAt}>
        <div>
          <div class="model-card-top">
            <div class="model-meta model-task-tags">{model.tasks.map((task) => <span class="model-task-tag" data-task={task}>{taskLabels[task]}</span>)}</div>
            {interactive && <label class="compare-check"><input type="checkbox" data-compare />加入对比</label>}
            {!interactive && <span class="model-number">{String(index + 1).padStart(2, '0')}</span>}
          </div>
          <h2><a href={`/models/${model.id}/`}>{model.name}</a></h2>
          <p>{model.summary}</p>
        </div>
        <div class="model-facts">
          <span title={model.parameters.notes}>{model.parameters.totalB === null ? '规模未提供' : `公开规模 ${model.parameters.totalB}B`}</span>
          <span>{model.licenses.weights.name}</span>
          <span>核实于 {model.checkedAt}</span>
        </div>
      </li>
    ))}
    {interactive && <li class="catalog-empty" data-empty-state hidden><p>没有符合条件的模型。</p><button type="button" data-reset-filters>清空筛选条件</button></li>}
  </ul>
  {interactive && <aside class="compare-tray" data-compare-tray hidden aria-label="已选模型对比">
    <div class="compare-tray-head"><h2>选中 <span data-selected-count>0</span> / 3</h2><button type="button" data-clear-compare>清空</button></div>
    <div class="compare-items" data-compare-items></div>
    <p class="compare-warning" data-compare-warning aria-live="polite"></p>
    <div class="compare-actions"><a href="/compare/" data-compare-link hidden>查看完整对比</a><button type="button" data-copy-compare hidden>复制分享链接</button><a href="/compare/" data-copy-fallback hidden></a><span data-copy-status role="status" aria-live="polite"></span></div>
  </aside>}
</div>

{interactive && <script>
  import { validateComparison } from '../lib/compare.ts';
  import { parseCatalogQuery, writeCatalogQuery } from '../lib/catalog-query.ts';

  const catalog = document.querySelector('[data-model-catalog]');
  if (catalog) {
    const cards = [...catalog.querySelectorAll<HTMLLIElement>('[data-model-card]')];
    const list = catalog.querySelector<HTMLUListElement>('.model-list')!;
    const tray = catalog.querySelector<HTMLElement>('[data-compare-tray]')!;
    const compareItems = catalog.querySelector<HTMLElement>('[data-compare-items]')!;
    const warning = catalog.querySelector<HTMLElement>('[data-compare-warning]')!;
    const selectionError = catalog.querySelector<HTMLElement>('[data-selection-error]')!;
    const selectedCount = catalog.querySelector<HTMLElement>('[data-selected-count]')!;
    const queryControls = [...document.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-query]')];
    const taskControl = catalog.parentElement?.querySelector<HTMLSelectElement>('[data-query="task"]');
    const sizeControl = catalog.parentElement?.querySelector<HTMLSelectElement>('[data-query="size"]');
    const compareLink = catalog.querySelector<HTMLAnchorElement>('[data-compare-link]')!;
    const copyButton = catalog.querySelector<HTMLButtonElement>('[data-copy-compare]')!;
    const copyFallback = catalog.querySelector<HTMLAnchorElement>('[data-copy-fallback]')!;
    const copyStatus = catalog.querySelector<HTMLElement>('[data-copy-status]')!;
    const selected = new Set<string>();
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const queryOptions = {
      tasks: [...(taskControl?.options ?? [])].map(({ value }) => value).filter((value) => value !== 'all'),
      sizes: [...(sizeControl?.options ?? [])].map(({ value }) => value).filter((value) => value !== 'all'),
      licenses: [...new Set(cards.map((card) => card.dataset.license!))],
      runtimes: [...new Set(cards.flatMap((card) => JSON.parse(card.dataset.runtimes ?? '[]') as string[]))],
    };
    let state = parseCatalogQuery(location.search, queryOptions);
    const syncControls = () => {
      for (const control of queryControls) {
        control.value = state[control.dataset.query as keyof typeof state];
        control.dispatchEvent(new Event('catalog:sync'));
      }
    };
    syncControls();

    const commonTasks = (chosen: HTMLLIElement[]) => chosen.length < 2 ? [] : chosen[0].dataset.tasks!.split(' ').filter((task) => chosen.every((card) => card.dataset.tasks!.split(' ').includes(task)));
    const restoreSelection = () => {
      const params = new URLSearchParams(location.search);
      if (!params.has('ids')) { selectionError.hidden = true; return; }
      const requested = (params.get('ids') ?? '').split(',');
      const models = cards.map((card) => ({ id: card.dataset.id!, tasks: card.dataset.tasks!.split(' ') }));
      const comparison = validateComparison(requested, models);
      if (!comparison.ok) {
        selectionError.textContent = comparison.message;
        selectionError.hidden = false;
        return;
      }
      selectionError.hidden = true;
      const chosen = comparison.ids.map((id) => cards.find((card) => card.dataset.id === id)!);
      chosen.forEach((card) => selected.add(card.dataset.id!));
      syncControls();
    };
    restoreSelection();

    const persist = (mode: 'push' | 'replace' = 'push') => {
      selectionError.hidden = true;
      const url = writeCatalogQuery(new URL(location.href), state);
      if (selected.size) url.searchParams.set('ids', [...selected].join(','));
      else url.searchParams.delete('ids');
      if (url.href === location.href) return;
      history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
    };

    const animateLayout = (change: () => void) => {
      const before = new Map(cards.filter((card) => !card.hidden).map((card) => [card, card.getBoundingClientRect()]));
      change();
      if (reduceMotion.matches) return;
      for (const [card, oldRect] of before) {
        if (card.hidden) continue;
        const next = card.getBoundingClientRect();
        const x = oldRect.left - next.left;
        const y = oldRect.top - next.top;
        if (x || y) card.animate([{ transform: `translate(${x}px, ${y}px)` }, { transform: 'translate(0, 0)' }], { duration: 240, easing: 'cubic-bezier(.2,.75,.25,1)' });
      }
    };

    const render = () => {
      const needle = state.q.toLocaleLowerCase('zh-CN');
      const matches = (card: HTMLLIElement) => {
        const tasks = card.dataset.tasks!.split(' ');
        const search = (card.dataset.search ?? '').toLocaleLowerCase('zh-CN');
        const runtimes = JSON.parse(card.dataset.runtimes ?? '[]') as string[];
        return (!needle || needle.split(' ').every((word) => search.includes(word)))
          && (state.task === 'all' || tasks.includes(state.task))
          && (state.size === 'all' || card.dataset.size === state.size)
          && (state.license === 'all' || card.dataset.license === state.license)
          && (state.runtime === 'all' || runtimes.includes(state.runtime));
      };
      animateLayout(() => {
        const visible = cards.filter(matches);
        for (const card of cards) card.hidden = !matches(card);
        visible.sort((a, b) => {
          if (state.sort === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '', 'zh-CN');
          if (state.sort === 'size') {
            const left = a.dataset.parameters === '' ? null : Number(a.dataset.parameters);
            const right = b.dataset.parameters === '' ? null : Number(b.dataset.parameters);
            return left === null ? right === null ? 0 : 1 : right === null ? -1 : left - right;
          }
          return (b.dataset.checked ?? '').localeCompare(a.dataset.checked ?? '');
        });
        for (const card of visible) list.append(card);
      });
      catalog.querySelector('[data-empty-state]')?.toggleAttribute('hidden', visibleCount() > 0);
      const results = catalog.querySelector('[data-results-count]');
      if (results) {
        results.textContent = `${visibleCount()}/${cards.length}`;
        results.setAttribute('aria-label', `显示 ${visibleCount()} 个模型，共 ${cards.length} 个`);
      }
      renderCompare();
    };

    const visibleCount = () => cards.filter((card) => !card.hidden).length;

    const renderCompare = () => {
      const chosen = cards.filter((card) => selected.has(card.dataset.id!));
      const wasHidden = tray.hidden;
      tray.hidden = chosen.length === 0;
      document.body.classList.toggle('has-compare-tray', chosen.length > 0);
      if (wasHidden && !tray.hidden && !reduceMotion.matches) tray.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 180, easing: 'ease-out' });
      selectedCount.textContent = String(chosen.length);
      for (const input of catalog.querySelectorAll<HTMLInputElement>('[data-compare]')) {
        input.checked = selected.has(input.closest<HTMLLIElement>('[data-model-card]')!.dataset.id!);
        if (input.checked) { input.disabled = false; continue; }
        const candidate = input.closest<HTMLLIElement>('[data-model-card]')!;
        const compatible = chosen.length === 0 || commonTasks([...chosen, candidate]).length > 0;
        input.disabled = chosen.length >= 3 || !compatible;
      }
      compareItems.replaceChildren(...chosen.map((card) => {
        const item = document.createElement('div');
        item.className = 'compare-item';
        const title = document.createElement('strong');
        title.textContent = card.dataset.name ?? '';
        const details = document.createElement('span');
        details.textContent = `${card.dataset.taskLabels ?? ''} · ${card.dataset.parameters ?? ''} · ${card.dataset.license ?? ''}`;
        item.append(title, details);
        return item;
      }));
      copyStatus.textContent = '';
      copyFallback.hidden = true;
      if (chosen.length > 1) {
        const shared = commonTasks(chosen);
        warning.textContent = `共同用途：${shared.map((task) => taskControl?.querySelector<HTMLOptionElement>(`option[value="${CSS.escape(task)}"]`)?.textContent ?? task).join('、')}。参数口径请查看详情；不同条件的评测不可直接横向排名。`;
      } else warning.textContent = '请继续选择有共同用途的型号；一次最多三个。参数统计口径可能不同，评测不作跨模型排名。';
      compareLink.hidden = chosen.length < 2;
      copyButton.hidden = chosen.length < 2;
      if (chosen.length > 1) {
        const shared = commonTasks(chosen);
        const compareUrl = new URL('/compare/', location.origin);
        compareUrl.searchParams.set('ids', chosen.map((card) => card.dataset.id!).join(','));
        compareUrl.searchParams.set('task', shared.includes(state.task) ? state.task : shared[0]);
        compareLink.href = `${compareUrl.pathname}${compareUrl.search}`;
        copyFallback.href = compareLink.href;
      }
    };

    queryControls.forEach((control) => control.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', () => {
      const key = control.dataset.query as keyof typeof state;
      state[key] = key === 'q' ? control.value.trim().replace(/\s+/g, ' ').slice(0, 120) : control.value;
      render();
      persist(key === 'q' ? 'replace' : 'push');
    }));
    catalog.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
      state = { q: '', task: 'all', size: 'all', license: 'all', runtime: 'all', sort: 'recent' };
      syncControls();
      render();
      persist();
    });
    catalog.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLInputElement) || !event.target.matches('[data-compare]')) return;
      const input = event.target;
      const id = input.closest<HTMLLIElement>('[data-model-card]')!.dataset.id!;
      if (input.checked) {
        const chosen = cards.filter((card) => selected.has(card.dataset.id!));
        const candidate = input.closest<HTMLLIElement>('[data-model-card]')!;
        if (chosen.length >= 3 || (chosen.length && !commonTasks([...chosen, candidate]).length)) {
          input.checked = false;
          warning.textContent = chosen.length >= 3 ? '一次最多选择 3 个模型。' : '这个模型与已选模型没有共同用途，不能加入同一组对比。';
          return;
        }
        selected.add(id);
      } else selected.delete(id);
      renderCompare();
      persist();
    });
    catalog.querySelector('[data-clear-compare]')?.addEventListener('click', () => {
      selected.clear();
      catalog.querySelectorAll<HTMLInputElement>('[data-compare]').forEach((input) => { input.checked = false; });
      renderCompare();
      persist();
    });
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(new URL(compareLink.href, location.href).href);
        copyStatus.textContent = '已复制对比分享链接。';
        copyFallback.hidden = true;
      } catch {
        copyStatus.textContent = '自动复制不可用，请使用下方链接。';
        copyFallback.textContent = new URL(compareLink.href, location.href).href;
        copyFallback.hidden = false;
      }
    });
    addEventListener('popstate', () => {
      state = parseCatalogQuery(location.search, queryOptions);
      syncControls();
      selected.clear();
      catalog.querySelectorAll<HTMLInputElement>('[data-compare]').forEach((input) => { input.checked = false; });
      restoreSelection();
      for (const card of cards) {
        const input = card.querySelector<HTMLInputElement>('[data-compare]');
        if (input) input.checked = selected.has(card.dataset.id!);
      }
      render();
    });
    render();
  }
</script>}
