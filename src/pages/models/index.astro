---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ModelList from '../../components/ModelList.astro';
import CatalogSelect from '../../components/CatalogSelect.astro';
import { taskLabels } from '../../lib/catalog.ts';

const models = await getCollection('models');
const taskCounts = Object.entries(taskLabels).map(([id, label]) => ({
  id,
  label,
  count: models.filter(({ data }) => data.tasks.includes(id as keyof typeof taskLabels)).length,
})).filter((task) => task.count > 0);
const licenseOptions = [...new Set(models.map(({ data }) => data.licenses.weights.name))].sort();
const runtimeOptions = [...new Set(models.flatMap(({ data }) => data.deployments.map(({ runtime }) => runtime)))].sort();
const sizeOptions = [
  { id: 'under-1b', label: '小于 1B' },
  { id: '1-3b', label: '1B 至小于 3B' },
  { id: '3-8b', label: '3B 至小于 8B' },
  { id: '8b-plus', label: '8B 及以上' },
  { id: 'unknown', label: '规模未提供' },
];
---
<Base title="模型目录">
  <section class="catalog-head">
    <div>
      <p class="eyebrow">MODEL INDEX / 01</p>
      <h1>模型目录</h1>
      <p class="lead">按任务筛选，逐个了解模型的长处、边界与部署入口。参数和评测各自保留来源口径。</p>
    </div>
    <div class="catalog-count" aria-label={`${models.length} 个收录型号`}><strong>{String(models.length).padStart(2, '0')}</strong><span>收录型号</span></div>
  </section>
  <section class="catalog-tools" aria-label="筛选和排序模型">
    <label class="catalog-search"><span class="filter-label">搜索模型</span><input type="search" data-query="q" placeholder="名称、系列或用途" autocomplete="off" maxlength="120"></label>
    <div class="catalog-filter-grid" aria-label="组合筛选">
      <CatalogSelect label="用途" name="task" options={[{ value: 'all', label: '全部用途' }, ...taskCounts.map(({ id, label }) => ({ value: id, label }))]} />
      <CatalogSelect label="参数规模" name="size" options={[{ value: 'all', label: '全部规模' }, ...sizeOptions.map(({ id, label }) => ({ value: id, label }))]} />
      <CatalogSelect label="权重许可" name="license" options={[{ value: 'all', label: '全部许可' }, ...licenseOptions.map((license) => ({ value: license, label: license }))]} />
      <CatalogSelect label="部署运行时" name="runtime" options={[{ value: 'all', label: '全部运行时' }, ...runtimeOptions.map((runtime) => ({ value: runtime, label: runtime }))]} />
      <CatalogSelect label="排序方式" name="sort" options={[{ value: 'recent', label: '最近核实' }, { value: 'name', label: '名称 A–Z' }, { value: 'size', label: '公开规模' }]} />
    </div>
  </section>
  <ModelList models={models} interactive />
  <p class="muted">规模按各来源公开口径筛选，不代表相同统计范围或运行内存；未知规模独立收录，详情保留口径说明。</p>
</Base>

<style>
  .catalog-tools { grid-template-columns: minmax(220px, .8fr) minmax(0, 2fr); }
  .catalog-search { display: grid; align-content: end; gap: 8px; }
  .catalog-search input { width: 100%; min-height: 44px; padding: 8px 12px; border: var(--border); border-radius: var(--radius-md); background: var(--paper); color: var(--ink); font: inherit; }
  .catalog-filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .catalog-filter-grid .sort-control { min-width: 0; }
  .catalog-filter-grid select { width: 100%; min-width: 0; }
  @media (max-width: 760px) {
    .catalog-tools { grid-template-columns: 1fr; }
    .catalog-filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .catalog-filter-grid { grid-template-columns: 1fr; }
  }
</style>
