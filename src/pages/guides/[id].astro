---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('guides')).map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}
interface Props { guide: CollectionEntry<'guides'>; }
const { guide } = Astro.props;
const { Content } = await render(guide);
---
<Base title={guide.data.title} description={guide.data.description}>
  <article class="prose"><h1>{guide.data.title}</h1><p class="lead">{guide.data.description}</p><Content /></article>
</Base>
