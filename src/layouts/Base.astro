---
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = '按用途了解小模型的特点、能力依据与官方部署方式。', noindex = false } = Astro.props;
const pageTitle = Astro.url.pathname === '/' ? title : `${title} · 小模型图鉴`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="小模型图鉴" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/">小模型图鉴<span>smodel</span></a>
      <nav aria-label="主导航">
        <a href="/models/" aria-current={Astro.url.pathname.startsWith('/models/') ? 'page' : undefined}>模型目录</a>
        <a href="/guides/official-quickstart/" aria-current={Astro.url.pathname.startsWith('/guides/') ? 'page' : undefined}>部署指南</a>
        <a href="/methodology/" aria-current={Astro.url.pathname === '/methodology/' ? 'page' : undefined}>收录方法</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>内容根据官方资料整理。评测来源与运行验证状态分别标注。</span><span><a href="/contribute/">贡献与许可</a> · <a href="https://github.com/lincux0/smodel">源码</a></span></footer>
  </body>
</html>
